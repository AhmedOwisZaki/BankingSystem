<Window x:Class="BankApp.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="800" Height="470"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False">

    <Border CornerRadius="12" ClipToBounds="True">

        <!-- Background: splash image fills the whole window -->
        <Grid>
            <Image Source="Resources/splash_screen.png"
                   Stretch="UniformToFill" />

            <!-- Subtle dark overlay for text contrast -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0.0" />
                        <GradientStop Color="#CC0F172A"  Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Content stack centred on the window -->
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0">

                <!-- Bank icon -->
                <TextBlock Text="🏛️"
                           FontSize="72"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#F59E0B" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- App title -->
                <TextBlock Text="BANKING WORKSPACE"
                           FontSize="36" FontWeight="Bold"
                           FontFamily="Segoe UI"
                           Foreground="#F59E0B"
                           HorizontalAlignment="Center"
                           Typography.Kerning="False"
                           Margin="0,0,0,8">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#F59E0B" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Divider line -->
                <Rectangle Height="1" Width="320" Margin="0,4,0,12">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent"   Offset="0.0"/>
                            <GradientStop Color="#F59E0B"        Offset="0.5"/>
                            <GradientStop Color="Transparent"   Offset="1.0"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Tagline -->

            </StackPanel>

            <!-- Progress bar at bottom -->
            <Border VerticalAlignment="Bottom" Margin="40,0,40,24" Height="4" CornerRadius="2" Background="#1E293B">
                <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#6366F1" Offset="0"/>
                            <GradientStop Color="#F59E0B" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Border>

            <!-- Version label bottom-right -->
            <TextBlock Text="v1.0.0"
                       VerticalAlignment="Bottom" HorizontalAlignment="Right"
                       Margin="0,0,44,28"
                       FontSize="11" Foreground="#475569"
                       FontFamily="Segoe UI"/>
        </Grid>
    </Border>
</Window>
